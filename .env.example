# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=nbo
POSTGRES_PASSWORD=nbo
POSTGRES_DB=nbo
DB_PORT=5432
# Interfaz donde se publica el puerto de la base. 127.0.0.1 la deja accesible
# solo desde el propio host. Cámbialo solo si sabes por qué lo necesitas.
DB_BIND=127.0.0.1

# --- API ----------------------------------------------------------------
# Dentro de compose el host es el nombre del servicio: db
DATABASE_URL=postgresql+psycopg://nbo:nbo@db:5432/nbo
CORS_ORIGINS=http://localhost:5173
API_PORT=8000
# Motor de IA dentro de la red de compose
AI_ENGINE_URL=http://ai:8000

# --- AI Engine (copiloto) -----------------------------------------------
AI_PORT=8100
# deterministic no necesita API key. Para probar un LLM: openai
AI_ENGINE_GENERATOR=deterministic
AI_ENGINE_CORS_ORIGINS=*

# --- Web ----------------------------------------------------------------
WEB_PORT=5173
# Destino del proxy /api dentro de la red de compose
VITE_API_PROXY=http://api:8000
# Hosts públicos desde los que se sirve el dashboard, separados por coma.
# En local se puede dejar vacío. En un servidor hay que poner su IP o dominio:
# VITE_ALLOWED_HOSTS=34.176.22.197
VITE_ALLOWED_HOSTS=
